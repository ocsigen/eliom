; Eliom manual pages (odoc .mld), installed with the package under
; odoc-pages/, where odoc_driver (ocaml.org, wodoc) builds them with the API.
; The manual is a tree: each subdirectory is a group of the navigation (its
; index.mld gives the group title and the order of its pages), installed
; with the same path.

(documentation
 (package eliom)
 (files
  (glob_files_rec
   (*.mld with_prefix .))))

; The per-package odoc configuration must sit at the root of the installed
; doc directory, next to odoc-pages/, for odoc_driver to find it.

(install
 (section doc)
 (package eliom)
 (files odoc-config.sexp))
