(data_only_dirs templates)

; Install the distillery templates into lib/eliom/templates/<name>/
; so that eliom-distillery picks them up at the standard location.
(install
 (package eliom)
 (section lib_root)
 (files
  (glob_files_rec
   (templates/app.exe/* with_prefix eliom/templates/app.exe))
  (glob_files_rec
   (templates/app.lib/* with_prefix eliom/templates/app.lib))
  (glob_files_rec
   (templates/basic.ppx/* with_prefix eliom/templates/basic.ppx))))
