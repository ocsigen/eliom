(rule (target content.ml)
 (deps ../content.eliom (file ../server/.eliom_server.objs/byte/eliom__Content.cmo))
  (action
    (with-stdout-to %{target}
      (chdir .. (run ppx_eliom_client --as-pp -internal -server-cmo server/.eliom_server.objs/byte/eliom__Content.cmo --impl content.eliom)))))
